# name: test/sql/settings/security_mode_snapshot.test
# description: Settings that SQL cannot change in secure mode. Review any change to this list.
# group: [settings]

query II
SELECT name, security FROM duckdb_settings(include_all := true)
WHERE security NOT IN ('sql_changeable', 'undeclared')
  AND name NOT IN (SELECT unnest(aliases) FROM duckdb_settings(include_all := true))
ORDER BY name
----
